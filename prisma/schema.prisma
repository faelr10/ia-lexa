generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model schedule {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  assunto   String
  descricao String
  dia       String
  horario   String
  status    String
}
